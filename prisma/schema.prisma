generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfficerStatus {
  ACTIVE
  LOA
  SUSPENDED
  TERMINATED
}

enum DutyStatus {
  OFF_DUTY
  AVAILABLE
  ON_DUTY
  BUSY
}

model User {
  id            String    @id @default(cuid())
  discordId     String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  officer       Officer?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Officer {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber String          @unique
  callsign    String?         @unique
  rankId      String?
  rank        Rank?           @relation(fields: [rankId], references: [id])
  divisionId  String?
  division    Division?       @relation(fields: [divisionId], references: [id])
  status      OfficerStatus   @default(ACTIVE)
  dutyStatus  DutyStatus      @default(OFF_DUTY)
  hiredAt     DateTime        @default(now())
  patrols     PatrolSession[]
  reports     Report[]
  trainingRecords TrainingRecord[]
  leaveRequests LeaveRequest[]
}

model Rank {
  id            String    @id @default(cuid())
  name          String    @unique
  priority      Int       @default(0)
  discordRoleId String?   @unique
  officers      Officer[]
}

model Division {
  id            String    @id @default(cuid())
  name          String    @unique
  discordRoleId String?   @unique
  officers      Officer[]
}

model PatrolSession {
  id        String    @id @default(cuid())
  officerId String
  officer   Officer   @relation(fields: [officerId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  minutes   Int?
}

model Report {
  id        String   @id @default(cuid())
  number    String   @unique
  title     String
  type      String
  status    String   @default("DRAFT")
  narrative String?  @db.Text
  officerId String
  officer   Officer  @relation(fields: [officerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscordRoleMapping {
  id            String   @id @default(cuid())
  discordRoleId String   @unique
  label         String?
  appRole       String
  syncEnabled   Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model TrainingCourse {
  id String @id @default(cuid())
  name String @unique
  description String? @db.Text
  validDays Int?
  active Boolean @default(true)
  records TrainingRecord[]
  createdAt DateTime @default(now())
}

model TrainingRecord {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  courseId String
  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt DateTime @default(now())
  expiresAt DateTime?
  notes String? @db.Text
  createdAt DateTime @default(now())
  @@unique([officerId, courseId])
}

model LeaveRequest {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate DateTime
  reason String @db.Text
  status String @default("PENDING")
  reviewNote String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FleetVehicle {
  id String @id @default(cuid())
  unitNumber String @unique
  year Int?
  make String
  model String
  plate String? @unique
  status String @default("AVAILABLE")
  mileage Int @default(0)
  assignedOfficerId String?
  notes String? @db.Text
  lastServiceAt DateTime?
  nextServiceMileage Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
