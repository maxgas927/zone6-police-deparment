generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfficerStatus {
  ACTIVE
  LOA
  SUSPENDED
  TERMINATED
}
enum DutyStatus {
  OFF_DUTY
  AVAILABLE
  ON_DUTY
  BUSY
}

model User {
  id String @id @default(cuid())
  discordId String? @unique
  email String? @unique
  emailVerified DateTime?
  name String?
  image String?
  accounts Account[]
  sessions Session[]
  officer Officer?
  policyAcknowledgements PolicyAcknowledgement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,providerAccountId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model VerificationToken {
  identifier String
  token String
  expires DateTime
  @@unique([identifier,token])
}

model Officer {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  badgeNumber String @unique
  callsign String? @unique
  rankId String?
  rank Rank? @relation(fields:[rankId],references:[id])
  divisionId String?
  division Division? @relation(fields:[divisionId],references:[id])
  subdivisionId String?
  subdivision Subdivision? @relation(fields:[subdivisionId],references:[id])
  status OfficerStatus @default(ACTIVE)
  dutyStatus DutyStatus @default(OFF_DUTY)
  hiredAt DateTime @default(now())
  patrols PatrolSession[]
  reports Report[]
  trainingRecords TrainingRecord[]
  leaveRequests LeaveRequest[]
  fleetVehicles FleetVehicle[]
  equipmentAssets EquipmentAsset[]
  promotionHistory PromotionHistory[]
  arrests Arrest[]
  citations Citation[]
  evidenceItems EvidenceItem[]
  shifts ShiftAssignment[]
  commendations Commendation[]
}

model Rank {
  id String @id @default(cuid())
  name String @unique
  priority Int @default(0)
  discordRoleId String? @unique
  officers Officer[]
}

model Division {
  id String @id @default(cuid())
  name String @unique
  discordRoleId String? @unique
  officers Officer[]
  subdivisions Subdivision[]
}

model Subdivision {
  id String @id @default(cuid())
  name String
  divisionId String
  division Division @relation(fields:[divisionId],references:[id],onDelete:Cascade)
  discordRoleId String? @unique
  officers Officer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([divisionId,name])
}

model PatrolSession {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  startedAt DateTime @default(now())
  endedAt DateTime?
  minutes Int?
}

model Report {
  id String @id @default(cuid())
  number String @unique
  title String
  type String
  status String @default("DRAFT")
  narrative String? @db.Text
  reviewNote String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  officerId String
  officer Officer @relation(fields:[officerId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incidentAt DateTime?
  location String?
  involvedPersons String? @db.Text
  involvedVehicles String? @db.Text
  charges String? @db.Text
  evidence String? @db.Text
}

model Application {
  id String @id @default(cuid())
  applicantName String
  discordName String?
  age String?
  timezone String?
  experience String? @db.Text
  whyJoin String @db.Text
  availability String? @db.Text
  additional String? @db.Text
  status String @default("PENDING")
  reviewNote String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionHistory {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  fromRank String?
  toRank String
  reason String? @db.Text
  approvedBy String?
  createdAt DateTime @default(now())
}

model DiscordWebhook {
  id String @id @default(cuid())
  channel String @unique
  url String @db.Text
  updatedBy String?
  enabled Boolean @default(true)
  events Json?
  lastSuccessAt DateTime?
  lastError String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscordRoleMapping {
  id String @id @default(cuid())
  discordRoleId String @unique
  label String?
  appRole String
  syncEnabled Boolean @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
}

model TrainingCourse {
  id String @id @default(cuid())
  name String @unique
  description String? @db.Text
  validDays Int?
  active Boolean @default(true)
  records TrainingRecord[]
  createdAt DateTime @default(now())
}

model TrainingRecord {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  courseId String
  course TrainingCourse @relation(fields:[courseId],references:[id],onDelete:Cascade)
  issuedAt DateTime @default(now())
  expiresAt DateTime?
  notes String? @db.Text
  createdAt DateTime @default(now())
  @@unique([officerId,courseId])
}

model LeaveRequest {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  startDate DateTime
  endDate DateTime
  reason String @db.Text
  status String @default("PENDING")
  reviewNote String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FleetVehicle {
  id String @id @default(cuid())
  unitNumber String @unique
  year Int?
  make String
  model String
  plate String? @unique
  status String @default("AVAILABLE")
  mileage Int @default(0)
  assignedOfficerId String?
  assignedOfficer Officer? @relation(fields:[assignedOfficerId],references:[id],onDelete:SetNull)
  notes String? @db.Text
  lastServiceAt DateTime?
  nextServiceMileage Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentAsset {
  id String @id @default(cuid())
  assetNumber String @unique
  name String
  category String
  serialNumber String? @unique
  status String @default("AVAILABLE")
  assignedOfficerId String?
  assignedOfficer Officer? @relation(fields:[assignedOfficerId],references:[id],onDelete:SetNull)
  issuedAt DateTime?
  dueAt DateTime?
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisciplineCase {
  id String @id @default(cuid())
  caseNumber String @unique
  officerId String
  title String
  category String
  status String @default("OPEN")
  summary String @db.Text
  outcome String? @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String @db.Text
  priority String @default("NORMAL")
  authorId String?
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bolo {
  id String @id @default(cuid())
  number String @unique
  type String
  priority String @default("NORMAL")
  subject String
  description String @db.Text
  vehicle String?
  plate String?
  imageUrl String?
  relatedReport String?
  status String @default("ACTIVE")
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warrant {
  id String @id @default(cuid())
  number String @unique
  subject String
  charges String @db.Text
  summary String? @db.Text
  priority String @default("NORMAL")
  relatedReport String?
  status String @default("ACTIVE")
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Arrest {
  id String @id @default(cuid())
  number String @unique
  subject String
  charges String @db.Text
  location String?
  jail String?
  relatedReport String?
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  arrestedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model Citation {
  id String @id @default(cuid())
  number String @unique
  subject String
  violations String @db.Text
  fine Int?
  location String?
  relatedReport String?
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model EvidenceItem {
  id String @id @default(cuid())
  number String @unique
  name String
  category String
  description String? @db.Text
  storageLocation String?
  status String @default("STORED")
  relatedReport String?
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftAssignment {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  title String
  startsAt DateTime
  endsAt DateTime
  assignment String?
  supervisor String?
  status String @default("SCHEDULED")
  createdAt DateTime @default(now())
}

model DepartmentEvent {
  id String @id @default(cuid())
  title String
  type String
  startsAt DateTime
  endsAt DateTime?
  location String?
  description String? @db.Text
  createdBy String?
  createdAt DateTime @default(now())
}

model PolicyDocument {
  id String @id @default(cuid())
  title String
  category String
  version String @default("1.0")
  body String @db.Text
  effectiveAt DateTime?
  requiredAck Boolean @default(false)
  published Boolean @default(true)
  createdBy String?
  acknowledgements PolicyAcknowledgement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyAcknowledgement {
  id String @id @default(cuid())
  documentId String
  document PolicyDocument @relation(fields:[documentId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  acknowledgedAt DateTime @default(now())
  @@unique([documentId,userId])
}

model Commendation {
  id String @id @default(cuid())
  officerId String
  officer Officer @relation(fields:[officerId],references:[id],onDelete:Cascade)
  title String
  type String @default("COMMENDATION")
  reason String @db.Text
  issuedBy String?
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model OrganizationVacancy {
  id String @id @default(cuid())
  title String
  division String?
  subdivision String?
  rank String?
  status String @default("OPEN")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
